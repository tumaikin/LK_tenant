generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TENANT
  ADMIN
}

enum RequestStatus {
  NEW
  ACCEPTED
  IN_PROGRESS
  WAITING_FOR_TENANT
  COMPLETED
  CLOSED
  CANCELLED
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Tenant {
  id            String           @id @default(cuid())
  code          String           @unique
  name          String
  office        String
  floor         String
  contactEmail  String
  contactPhone  String
  users         User[]
  contracts     Contract[]
  billing       BillingRecord[]
  notifications Notification[]
  requests      ServiceRequest[]
  mockImports   MockEmailImport[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  password          String
  name              String
  role              UserRole
  title             String?
  tenantId          String?
  tenant            Tenant?            @relation(fields: [tenantId], references: [id])
  assignedRequests  ServiceRequest[]   @relation("AssignedExecutor")
  createdRequests   ServiceRequest[]   @relation("CreatedBy")
  authoredComments  RequestComment[]
  historyEntries    RequestHistory[]
  mockImports       MockEmailImport[]  @relation("ImportedBy")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Contract {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  number     String
  title      String
  startDate  DateTime
  endDate    DateTime
  areaSqm    Float
  status     String
  monthlyFee Float
  deposit    Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BillingRecord {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  period      String
  chargeType  String
  amount      Float
  paidAmount  Float
  dueDate     DateTime
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  title      String
  body       String
  category   String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model ServiceItem {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Float
  unit        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServiceRequest {
  id               String           @id @default(cuid())
  number           String           @unique
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  createdById      String
  createdBy        User             @relation("CreatedBy", fields: [createdById], references: [id])
  executorId       String?
  executor         User?            @relation("AssignedExecutor", fields: [executorId], references: [id])
  title            String
  description      String
  location         String
  category         String
  priority         RequestPriority
  status           RequestStatus    @default(NEW)
  source           String           @default("portal")
  emailFrom        String?
  emailSubject     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  comments         RequestComment[]
  history          RequestHistory[]
}

model RequestComment {
  id         String         @id @default(cuid())
  requestId  String
  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId   String
  author     User           @relation(fields: [authorId], references: [id])
  body       String
  createdAt  DateTime       @default(now())
}

model RequestHistory {
  id            String         @id @default(cuid())
  requestId     String
  request       ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId       String
  actor         User           @relation(fields: [actorId], references: [id])
  action        String
  fromStatus    RequestStatus?
  toStatus      RequestStatus?
  comment       String?
  createdAt     DateTime       @default(now())
}

model MockEmailImport {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  fromEmail      String
  subject        String
  body           String
  suggestedTitle String
  location       String
  category       String
  priority       RequestPriority
  importedAt     DateTime?
  importedById   String?
  importedBy     User?    @relation("ImportedBy", fields: [importedById], references: [id])
  requestId      String?
  createdAt      DateTime @default(now())
}
